{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hamednourhani/yue/schemas/run-output.schema.json",
  "title": "zao run-output schema",
  "description": "stdout envelope contract for zao ↔ Rey integration. Contains final run envelope and pending_interaction variant for HITL relay in json mode.",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string", "enum": ["0.2.0"] },
    "type": {
      "type": "string",
      "enum": ["pending_interaction"],
      "description": "Only present in pending_interaction variant. Absent in final envelope."
    },
    "session_id": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["complete", "failed"],
      "description": "Only in final envelope."
    },
    "task": { "type": "string" },
    "models": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["success", "failed", "skipped"] },
          "session_id": { "type": "string" }
        },
        "required": ["id", "role", "model", "status"],
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "result": { "type": "string" },
        "spec": { "type": "string" },
        "events": { "type": "string" }
      },
      "required": ["result", "spec", "events"],
      "additionalProperties": false
    },
    "tokens": {
      "type": "object",
      "properties": {
        "prompt": { "type": "integer", "minimum": 0 },
        "completion": { "type": "integer", "minimum": 0 }
      },
      "required": ["prompt", "completion"],
      "additionalProperties": false
    },
    "error": {
      "type": ["string", "null"],
      "description": "Error message on failure, null on success."
    },
    "interaction_id": {
      "type": "string",
      "description": "Only in pending_interaction variant."
    },
    "tier": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "description": "Only in pending_interaction variant."
    },
    "action": {
      "type": "string",
      "enum": ["shell", "write_file", "read_file"],
      "description": "Only in pending_interaction variant."
    },
    "command": { "type": "string", "description": "Only in pending_interaction variant." },
    "reasons": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Only in pending_interaction variant."
    },
    "diff": {
      "type": ["string", "null"],
      "description": "Only in pending_interaction variant. Always null in v1."
    },
    "session_state": {
      "type": "object",
      "properties": {
        "current_step": { "type": "string" },
        "step_index": { "type": "integer", "minimum": 0 },
        "total_steps": { "type": "integer", "minimum": 1 }
      },
      "required": ["current_step", "step_index", "total_steps"],
      "additionalProperties": false,
      "description": "Only in pending_interaction variant."
    }
  },
  "required": ["schema_version", "session_id"],
  "allOf": [
    {
      "if": {
        "not": { "properties": { "type": { "const": "pending_interaction" } }, "required": ["type"] }
      },
      "then": {
        "required": ["status", "task", "models", "steps", "artifacts", "tokens", "error"]
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "pending_interaction" } }, "required": ["type"]
      },
      "then": {
        "required": ["type", "interaction_id", "tier", "action", "command", "reasons", "diff", "session_state"]
      }
    }
  ],
  "additionalProperties": false
}
